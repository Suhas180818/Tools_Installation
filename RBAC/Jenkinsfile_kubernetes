pipeline {

  agent any 

  environment{

    SA_ADMIN_TOKEN = credentials('20838008-9fb1-48d8-a7bc-e4bcb2bca142')

  }

  stages{
    stage('Git_checkout') {
      steps {
        checkout ([ 
            $class : 'GitSCM',
            branches: [[name: '*/master']], 
            extensions: [], 
            userRemoteConfigs: [[
                credentialsId: 'Git_repo_acess',
                url: 'https://github.com/Suhas180818/Tools_Installation.git'
            ]]
        ])
      }
    }
  
    stage('Kubectl') {
      steps { 
        sh'''
          set -x
          ARCHITECTURE=$(uname -m)
          if [[ $ARCHITECTURE == "x86_64" ]]; then
             curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"

          // elif [[ $ARCHITECTURE == "aarch64" ]]; then
          //   curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/arm64/kubectl"

          // else
           // echo "Need x86-64 Linux machine" 
           // exit 1
          fi
          
          cat kubectl --version

        '''
      }
    } 
    stage('KUBE-Context') {
        steps {
            sh'''
               kubectl config set-cluster Devops-cluster --server=https://172.31.41.59:6443 --insecure-skip-tls-verify=true

               kubectl config set-credentials sa-admin --token=$SA_ADMIN_TOKEN 

               kubectl config set-context QA-Access --cluster=Devops-cluster --user=sa-admin 

               kubectl config use-context QA-Access    

               kubectl get all   
            
            '''
        }
    }
    
    stage ('POD-DEPLOYMENT'){
        steps {
          sh'''
          kubectl apply -f application_controllers/deployment.yaml
          
          '''
        }

    }
  }
    
}
